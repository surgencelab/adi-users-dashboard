# Copy to .env and fill in. .env is git-ignored.

# Neon Postgres. Optional: the dashboard reads data.json and works without it.
# Create a project at https://neon.tech, then copy the POOLED connection
# string. The analytical tables are about 1M rows / 100 MB, which fits the
# free tier.
DATABASE_URL=

# Optional. A paid Ethereum RPC (Alchemy, Infura, drpc key) so the staking
# indexer is not subject to free-tier rate limits.
ETH_RPC_URL=

# Optional. Pulls staking events from Dune instead of scanning public RPC.
DUNE_API_KEY=

# Optional. Overrides the ADI Chain RPC endpoint.
ADI_RPC_URL=
